{
  "manifest_version": 3,
  "name": "NumberTyper Tab Audio",
  "version": "0.1.0",
  "description": "Captures selected-tab audio for local NumberTyper processing and can fill or submit @-prefixed numbers in the same tab.",
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NumberTyper tab audio"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "key": ""
}
